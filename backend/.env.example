# Copy to .env and fill in. NEVER commit .env.

# --- LLM provider ---
# This branch (ctx-space-claude) defaults to Claude via the Agent SDK.
# Set to "openai" to use the OpenAI path instead (parity with main branch).
LLM_PROVIDER=claude

# --- Claude (Agent SDK — subscription auth, no API key) ---
# Generate on a machine WITH a browser:  claude setup-token
# It prints a long-lived OAuth token (sk-ant-oat-...), valid ~1 year, NO auto-refresh.
# When it expires the backend returns 401 — re-run setup-token and replace this value.
# generated: <YYYY-MM-DD>  expires: ~+1yr  (set a reminder ~11 months out)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat-...
# WARNING: do NOT set ANTHROPIC_API_KEY anywhere in this environment — an API key
# OVERRIDES the OAuth token (auth precedence) and bills against the API, not the plan.
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_FALLBACK_MODEL=claude-haiku-4-5-20251001
# Per-run cost ceiling (USD-equiv) to protect the monthly Agent SDK credit. 0 = off.
CLAUDE_MAX_BUDGET_USD=0.0

# --- OpenAI (only needed if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5

# DataSpace MCP server (exposes schema/data tools to the agent).
MCP_SERVER_URL=https://dataspace-mcp.onrender.com/mcp
MCP_SERVER_LABEL=mps

# Comma-separated list of allowed frontend origins (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# --- GitHub (Publish — pushes generated code to your account) ---
# Generate a PAT at: https://github.com/settings/tokens (needs: repo scope)
GITHUB_TOKEN=github_pat_...
GITHUB_USERNAME=super-nived

# --- PocketBase (project storage) ---
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=
POCKETBASE_COLLECTION=ctx_space_projects
