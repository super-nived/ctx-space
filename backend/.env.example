# Copy to .env and fill in. NEVER commit .env.

# OpenAI API key — rotate the old leaked key before using.
OPENAI_API_KEY=sk-...

# Model used for chat + code generation.
OPENAI_MODEL=gpt-5

# DataSpace MCP server (exposes schema/data tools to the agent).
MCP_SERVER_URL=https://dataspace-mcp.onrender.com/mcp
MCP_SERVER_LABEL=mps

# Comma-separated list of allowed frontend origins (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# --- GitHub OAuth (Publish feature; fill when wiring P4) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/github/callback
SESSION_SECRET=change-me-to-a-long-random-string

# --- PocketBase (project storage) ---
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=
POCKETBASE_COLLECTION=ctx_space_projects
